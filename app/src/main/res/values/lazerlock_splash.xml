<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Branded launch splash via androidx.core:core-splashscreen. Set as the launcher activities' theme
         (MainActivity, AdminActivity). On Android 11 and older this draws the static LazerLock mark on brand
         navy; Android 12+ gets the platform splash (see values-v31) with the animation and wordmark.
         postSplashScreenTheme hands back to the app's normal theme — the activity then switches to light or
         dark itself in onCreate, exactly as before. -->
    <style name="Theme.LazerLock.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/lazerlock_navy</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_icon</item>
        <item name="postSplashScreenTheme">@style/AppTheme</item>
    </style>
</resources>
