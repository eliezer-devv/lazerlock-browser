<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Light, like the rest of the app's look: the ⋮ menu, text boxes, switches and wheels. The top bar
         keeps its own deep blue-black (set in the layout). -->
    <style name="AppTheme" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:colorPrimary">@color/bar</item>
        <item name="android:colorPrimaryDark">@color/bar</item>
        <item name="android:colorAccent">@color/accent</item>
        <item name="android:colorControlActivated">@color/accent</item>
        <item name="android:textColorPrimary">@color/text</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:statusBarColor">@color/bar</item>
        <item name="android:navigationBarColor">@color/bar</item>
        <item name="android:windowBackground">@color/bar</item>
        <!-- Native launch splash (Android 12+): the animated LazerLock mark on brand navy, with the wordmark
             branding image at the bottom. Older Android shows the static launcher icon. -->
        <item name="android:windowSplashScreenBackground" tools:targetApi="31">@color/lazerlock_navy</item>
        <item name="android:windowSplashScreenAnimatedIcon" tools:targetApi="31">@drawable/splash_icon_animated</item>
        <item name="android:windowSplashScreenAnimationDuration" tools:targetApi="31">1200</item>
        <item name="android:windowSplashScreenBrandingImage" tools:targetApi="31">@drawable/splash_branding</item>
    </style>

    <!-- Dark (⋮ → Appearance, or the phone's own setting): the same, on a dark base. -->
    <style name="AppThemeDark" parent="android:Theme.Material.NoActionBar">
        <item name="android:colorPrimary">@color/bar</item>
        <item name="android:colorPrimaryDark">@color/bar</item>
        <item name="android:colorAccent">@color/accent_dark</item>
        <item name="android:colorControlActivated">@color/accent_dark</item>
        <item name="android:textColorPrimary">@color/text_dark</item>
        <item name="android:statusBarColor">@color/bar</item>
        <item name="android:navigationBarColor">@color/bar</item>
        <item name="android:windowBackground">@color/bar</item>
        <item name="android:windowSplashScreenBackground" tools:targetApi="31">@color/lazerlock_navy</item>
        <item name="android:windowSplashScreenAnimatedIcon" tools:targetApi="31">@drawable/splash_icon_animated</item>
        <item name="android:windowSplashScreenAnimationDuration" tools:targetApi="31">1200</item>
        <item name="android:windowSplashScreenBrandingImage" tools:targetApi="31">@drawable/splash_branding</item>
    </style>

    <style name="ToolButton">
        <item name="android:layout_width">@dimen/tool_button</item>
        <item name="android:layout_height">@dimen/tool_button</item>
        <item name="android:background">?android:attr/selectableItemBackgroundBorderless</item>
        <item name="android:scaleType">center</item>
    </style>
</resources>
