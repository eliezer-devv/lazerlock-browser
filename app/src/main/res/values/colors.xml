<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- LazerLock palette v2. The live toolbar/status colour is set at runtime from Ui.BAR (blue in light, dark in
         dark); these values are the launch/fallback and the native theme accents. -->
    <color name="bar">#111A2B</color>          <!-- launch window / status fallback (dark, matches the splash) -->
    <color name="field">#1A2432</color>
    <color name="ink">#EAF1FA</color>
    <color name="muted">#93A2B8</color>
    <color name="bad">#E5604A</color>
    <color name="update">#1A5CB8</color>        <!-- the "update available" banner -->
    <color name="accent">#1A5CB8</color>
    <color name="text">#0F1A2A</color>
    <color name="paper">#F4F7FC</color>
    <color name="accent_dark">#3B9EFF</color>
    <color name="text_dark">#EAF1FA</color>
    <color name="splash_bg">#080B12</color>      <!-- native launch splash (icon on near-black) -->
</resources>
