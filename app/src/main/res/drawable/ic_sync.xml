<?xml version="1.0" encoding="utf-8"?>
<!-- Sync: a circular sync-arrow ring with a cloud clearly centred inside — distinct from Reload, and the same
     design the admin dashboard uses. Drawn as strokes (tinted at use), so it matches the dashboard's icon set. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp" android:height="24dp" android:viewportWidth="24" android:viewportHeight="24">
    <!-- The ring: two circular arrows. -->
    <path android:strokeColor="#E8F1EF" android:strokeWidth="1.8" android:fillColor="#00000000"
        android:strokeLineCap="round" android:strokeLineJoin="round"
        android:pathData="M3,12a9,9 0 0 1 9,-9 9.75,9.75 0 0 1 6.74,2.74L21,8" />
    <path android:strokeColor="#E8F1EF" android:strokeWidth="1.8" android:fillColor="#00000000"
        android:strokeLineCap="round" android:strokeLineJoin="round"
        android:pathData="M21,3v5h-5" />
    <path android:strokeColor="#E8F1EF" android:strokeWidth="1.8" android:fillColor="#00000000"
        android:strokeLineCap="round" android:strokeLineJoin="round"
        android:pathData="M21,12a9,9 0 0 1 -9,9 9.75,9.75 0 0 1 -6.74,-2.74L3,16" />
    <path android:strokeColor="#E8F1EF" android:strokeWidth="1.8" android:fillColor="#00000000"
        android:strokeLineCap="round" android:strokeLineJoin="round"
        android:pathData="M3,21v-5h5" />
    <!-- The cloud, centred inside the ring. Scaled 0.55 about the origin then nudged to the middle; its stroke
         width is pre-divided by the scale so it ends up the same weight (~1.7) as the ring. -->
    <group android:scaleX="0.55" android:scaleY="0.55" android:translateX="5.4" android:translateY="5.64">
        <path android:strokeColor="#E8F1EF" android:strokeWidth="3.09" android:fillColor="#00000000"
            android:strokeLineCap="round" android:strokeLineJoin="round"
            android:pathData="M17.5,19a4.5,4.5 0 0 0 0,-9 6,6 0 0 0 -11.6,-1.6A4,4 0 0 0 6,19z" />
    </group>
</vector>
